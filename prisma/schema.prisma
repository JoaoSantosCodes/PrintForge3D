// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plano {
  id               String    @id @default(cuid())
  nome             String    // ex: "Starter", "Pro", "Business"
  slug             String    @unique
  precoMensal      Float
  limiteImpressoras Int
  limitePecas      Int
  limitePedidosMes Int
  limiteUsuarios   Int       @default(5)
  ativo            Boolean   @default(true)
  createdAt        DateTime  @default(now())

  empresas         Empresa[]
}

model Empresa {
  id              String      @id @default(cuid())
  nome            String
  slug            String      @unique
  planoId         String
  plano           Plano       @relation(fields: [planoId], references: [id])
  status          String      @default("trial") // trial | ativo | inadimplente | cancelado | bloqueado | trial_expirado
  trialExpiraEm   DateTime?
  proximaCobranca DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  profiles        Profile[]
  printers        Printer[]
  filaments       Filament[]
  tintas          Tinta[]
  pecas           Peca[]
  pedidos         Pedido[]
  cupons          Cupom[]
  configuracao    Configuracao?
  filamentPriceHistories FilamentPriceHistory[]
}

model Profile {
  id                  String   @id // Supabase auth.users id
  email               String   @unique
  nome                String?
  role                String   @default("admin") // super_admin | admin | funcionario | cliente
  status              String   @default("aprovado") // pendente | aprovado | bloqueado
  aprovadoEm          DateTime?
  empresaId           String?
  empresa             Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  
  // Sistema de Indicação & Rede Binária
  codigoIndicacao     String?  @unique
  indicadorId         String?
  indicador           Profile? @relation("ArvoreIndicacao", fields: [indicadorId], references: [id], onDelete: SetNull)
  indicados           Profile[] @relation("ArvoreIndicacao")
  pernaIndicacao      String?  @default("esquerda") // esquerda | direita
  posicaoPreferencial String?  @default("auto")     // auto | esquerda | direita

  createdAt           DateTime @default(now())

  pedidos             Pedido[]
  registrosIndicado   IndicacaoRegistro[] @relation("RegistroIndicado")
  registrosIndicador  IndicacaoRegistro[] @relation("RegistroIndicador")
  rewardTransactions  RewardTransaction[]
  rewardRedemptions   RewardRedemption[]
  achievements        AchievementUser[]
  missionProgresses   MissionProgress[]
}

model IndicacaoRegistro {
  id           String   @id @default(cuid())
  indicadorId  String
  indicador    Profile  @relation("RegistroIndicador", fields: [indicadorId], references: [id], onDelete: Cascade)
  indicadoId   String
  indicado     Profile  @relation("RegistroIndicado", fields: [indicadoId], references: [id], onDelete: Cascade)
  perna        String   // esquerda | direita
  pontos       Int      @default(120)
  createdAt    DateTime @default(now())
}

model Printer {
  id                 String   @id @default(cuid())
  empresaId          String
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome               String
  modelo             String
  preco              Float
  consumoWatts       Float
  vidaUtilHoras      Float
  horasTrabalhadas   Float    @default(0)
  custoManutencaoAno Float    @default(0)
  createdAt          DateTime @default(now())
}

model Filament {
  id                 String                 @id @default(cuid())
  empresaId          String
  empresa            Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome               String
  marca              String
  material           String // PLA, ABS, PETG, TPU, Resina, etc.
  cor                String
  precoPorKg         Float
  pesoRestanteGramas Float                  @default(1000.0) // Peso restante em gramas
  createdAt          DateTime               @default(now())
  priceHistory       FilamentPriceHistory[]
}

model FilamentPriceHistory {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  filamentId String
  filament   Filament @relation(fields: [filamentId], references: [id], onDelete: Cascade)
  precoPorKg Float
  data       DateTime @default(now())
}

model Tinta {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  marca     String?
  tipo      String   // Acrílica, Spray, Primer, Verniz, Esmalte, Óleo, Pincel/Insumo
  cor       String?
  volumeMl  Float    @default(0) // Volume da embalagem em ml
  preco     Float    // Preço de compra em R$
  createdAt DateTime @default(now())
}

model Peca {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome       String
  descricao  String?
  categoria  String?
  fotoUrl    String?
  publicada  Boolean  @default(false)
  status     String   @default("em_producao") // em_producao | pronta | vendida
  createdAt  DateTime @default(now())

  custoImpressao CustoImpressao?
  custoPintura   CustoPintura?
  custoEmbalagem CustoEmbalagem?
  pedidos        Pedido[]
}

model Pedido {
  id             String     @id @default(cuid())
  empresaId      String
  empresa        Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteNome    String
  clienteContato String?    // telefone/whatsapp
  status         String     @default("pendente") // pendente | aguardando_pagamento | em_impressao | pintando | pronto | enviado | entregue | cancelado
  pago           Boolean    @default(false)
  precoAcordado  Float      @default(0)
  quantidade     Int        @default(1)
  cupomCodigo    String?
  pecaId         String
  peca           Peca       @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  usuarioId      String?
  usuario        Profile?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
}

model CustoImpressao {
  id               String @id @default(cuid())
  peca             Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId           String @unique
  printerId        String
  filamentId       String
  pesoGramas       Float
  tempoHoras       Float
  tarifaEnergiaKwh Float
}

model CustoPintura {
  id                 String @id @default(cuid())
  peca               Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId             String @unique
  custoTintas        Float
  tempoHoras         Float
  valorHoraMaoDeObra Float
}

model CustoEmbalagem {
  id                String  @id @default(cuid())
  peca              Peca    @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId            String  @unique
  materialDescricao String?
  custoUnitario     Float
}

model SolicitacaoExclusao {
  id        String   @id @default(cuid())
  usuarioId String
  email     String
  motivo    String?
  status    String   @default("pendente") // pendente | concluido | rejeitado
  createdAt DateTime @default(now())
}

model Configuracao {
  id        String   @id @default(cuid())
  empresaId String   @unique
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  chavePix  String?
  updatedAt DateTime @updatedAt
}

model Cupom {
  id                 String    @id @default(cuid())
  empresaId          String
  empresa            Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo             String
  percentualDesconto Float
  ativo              Boolean   @default(true)
  validoAte          DateTime?
  createdAt          DateTime  @default(now())

  @@unique([empresaId, codigo])
}

// -------------------------------------------------------------
// PRINTFORGE REWARDS — PROGRAMA DE RECOMPENSAS GAMIFICADO
// -------------------------------------------------------------

model RewardLevel {
  id            String   @id @default(cuid())
  nome          String   // Bronze, Prata, Ouro, Diamante, Platinum, Elite
  slug          String   @unique
  pontosMinimos Int
  icone         String   // Nome do ícone Lucide ou emoji
  cor           String   // HSL ou Hex de destaque
  beneficio     String
  badge         String
}

model RewardCatalog {
  id               String             @id @default(cuid())
  nome             String             // ex: "Filamento PLA Branco 1kg"
  descricao        String
  imagemUrl        String?
  categoria        String             // filamentos | resinas | pecas | acessorios | cupons | creditos | brindes | premium
  tipo             String             // fisico | digital
  pontosNecessarios Int
  estoque          Int                @default(100)
  ativo            Boolean            @default(true)
  createdAt        DateTime           @default(now())

  resgates         RewardRedemption[]
}

model RewardRedemption {
  id           String        @id @default(cuid())
  profileId    String
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rewardId     String
  reward       RewardCatalog @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  pontosGastos Int
  status       String        @default("pendente") // pendente | aprovado | enviado | concluido | cancelado
  codigoCupom  String?
  createdAt    DateTime      @default(now())
}

model RewardTransaction {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pontos    Int      // positivo para crédito, negativo para débito
  tipo      String   // credito | debito
  evento    String   // cadastro | loja_criada | primeira_assinatura | renovacao | upgrade | primeira_venda | resgate
  descricao String
  createdAt DateTime @default(now())
}

model Achievement {
  id               String            @id @default(cuid())
  nome             String
  descricao        String
  icone            String
  raridade         String            // comum | rara | epica | lendaria
  pontosRecompensa Int               @default(100)

  usuarios         AchievementUser[]
}

model AchievementUser {
  id            String      @id @default(cuid())
  profileId     String
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  conquistadoEm DateTime    @default(now())

  @@unique([profileId, achievementId])
}

model Mission {
  id               String            @id @default(cuid())
  titulo           String
  descricao        String
  categoria        String            // diaria | semanal | mensal
  pontosRecompensa Int
  meta             Int               @default(1)
  ativo            Boolean           @default(true)

  progresses       MissionProgress[]
}

model MissionProgress {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  missionId     String
  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progressoAtual Int      @default(0)
  concluida     Boolean  @default(false)
  concluidaEm   DateTime?

  @@unique([profileId, missionId])
}
