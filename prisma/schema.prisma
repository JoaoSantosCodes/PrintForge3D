generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id          String    @id // Mesmo ID do Supabase Auth (auth.users.id)
  email       String    @unique
  nome        String?
  role        String    @default("usuario") // "super_admin" | "admin" | "usuario"
  status      String    @default("pendente") // "pendente" | "aprovado" | "bloqueado"
  empresaId   String?
  empresa     Empresa?  @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  aprovadoEm  DateTime?

  pedidos     Pedido[]
}

model Plano {
  id                String    @id @default(cuid())
  nome              String    // ex: "Starter", "Pro", "Business"
  slug              String    @unique
  precoMensal       Float
  limiteImpressoras Int
  limitePecas       Int
  limitePedidosMes  Int
  limiteUsuarios    Int       // funcionários/atendentes da empresa, se aplicável
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now())

  empresas          Empresa[]
}

model Empresa {
  id               String    @id @default(cuid())
  nome             String
  slug             String    @unique // usado na URL pública /loja/[slug]
  planoId          String
  plano            Plano     @relation(fields: [planoId], references: [id])
  status           String    @default("trial") // trial | ativo | inadimplente | cancelado | bloqueado | trial_expirado
  trialExpiraEm    DateTime?
  proximaCobranca  DateTime?
  chavePixCobranca String?   // chave PIX da EMPRESA para receber de SEUS clientes (diferente da assinatura)
  createdAt        DateTime  @default(now())

  profiles         Profile[]
  printers         Printer[]
  filaments        Filament[]
  filamentPrices   FilamentPriceHistory[]
  tintas           Tinta[]
  pecas            Peca[]
  pedidos          Pedido[]
  cupons           Cupom[]
  configuracoes    Configuracao[]
  auditLogs        AuditLog[]
}

model AuditLog {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  adminId     String   // Profile.id de quem executou a ação
  acao        String   // ex: "aprovou_usuario", "bloqueou_usuario", "reativou_usuario"
  alvoId      String?  // Profile.id do usuário afetado, quando aplicável
  detalhes    String?  // texto livre opcional
  createdAt   DateTime @default(now())
}

model Printer {
  id                      String    @id @default(cuid())
  empresaId               String
  empresa                 Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome                    String
  modelo                  String?
  consumoWatts            Float
  preco                   Float
  vidaUtilHoras           Float
  custoManutencaoAno      Float     @default(0)
  horasUsoAcumuladas      Float     @default(0.0) // Horas de uso acumuladas desde a última manutenção
  ultimaManutencao        DateTime? // Data da última manutenção preventiva
  intervaloManutencaoHoras Float    @default(200.0) // Intervalo em horas para manutenção preventiva
  createdAt               DateTime  @default(now())
}

model Filament {
  id                 String                 @id @default(cuid())
  empresaId          String
  empresa            Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  marca              String?
  tipo               String                 // PLA, PETG, ABS, ASA, TPU, Resina
  cor                String
  precoPorKg         Float
  pesoRestanteGramas Float                  @default(1000.0) // Peso restante em gramas
  createdAt          DateTime               @default(now())
  priceHistory       FilamentPriceHistory[]
}

model FilamentPriceHistory {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  filamentId String
  filament   Filament @relation(fields: [filamentId], references: [id], onDelete: Cascade)
  precoPorKg Float
  data       DateTime @default(now())
}

model Tinta {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  marca     String?
  tipo      String   // Acrílica, Spray, Primer, Verniz, Esmalte, Óleo, Pincel/Insumo
  cor       String?
  volumeMl  Float    @default(0) // Volume da embalagem em ml
  preco     Float    // Preço de compra em R$
  createdAt DateTime @default(now())
}

model Peca {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome       String
  descricao  String?
  categoria  String?
  fotoUrl    String?
  publicada  Boolean  @default(false)
  status     String   @default("em_producao") // em_producao | pronta | vendida
  createdAt  DateTime @default(now())

  custoImpressao CustoImpressao?
  custoPintura   CustoPintura?
  custoEmbalagem CustoEmbalagem?
  pedidos        Pedido[]
}

model Pedido {
  id             String     @id @default(cuid())
  empresaId      String
  empresa        Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteNome    String
  clienteContato String?    // telefone/whatsapp
  status         String     @default("pendente") // pendente | aguardando_pagamento | em_impressao | pintando | pronto | enviado | entregue | cancelado
  pago           Boolean    @default(false)
  cupomCodigo    String?
  pecaId         String
  peca           Peca       @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  usuarioId      String?
  usuario        Profile?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  quantidade     Int        @default(1)
  precoAcordado  Float?
  observacoes    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  avaliacao      Avaliacao?
}

model Avaliacao {
  id          String   @id @default(cuid())
  pedidoId    String   @unique
  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  nota        Int      // 1 a 5
  comentario  String?
  createdAt   DateTime @default(now())
}

model CustoImpressao {
  id               String @id @default(cuid())
  peca             Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId           String @unique
  printerId        String
  filamentId       String
  pesoGramas       Float
  tempoHoras       Float
  tarifaEnergiaKwh Float
}

model CustoPintura {
  id                 String @id @default(cuid())
  peca               Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId             String @unique
  custoTintas        Float
  tempoHoras         Float
  valorHoraMaoDeObra Float
}

model CustoEmbalagem {
  id                String  @id @default(cuid())
  peca              Peca    @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId            String  @unique
  materialDescricao String?
  custoUnitario     Float
}

model SolicitacaoExclusao {
  id        String   @id @default(cuid())
  usuarioId String
  email     String
  motivo    String?
  status    String   @default("pendente") // pendente | concluido | rejeitado
  createdAt DateTime @default(now())
}

model Configuracao {
  id        String   @id @default(cuid())
  empresaId String   @unique
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  chavePix  String?
  updatedAt DateTime @updatedAt
}

model Cupom {
  id                 String    @id @default(cuid())
  empresaId          String
  empresa            Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo             String
  percentualDesconto Float
  ativo              Boolean   @default(true)
  validoAte          DateTime?
  createdAt          DateTime  @default(now())

  @@unique([empresaId, codigo])
}
