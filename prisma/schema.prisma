// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plano {
  id               String    @id @default(cuid())
  nome             String    // ex: "Starter", "Pro", "Business"
  slug             String    @unique
  precoMensal      Float
  limiteImpressoras Int
  limitePecas      Int
  limitePedidosMes Int
  limiteUsuarios   Int       @default(5)
  ativo            Boolean   @default(true)
  createdAt        DateTime  @default(now())

  empresas         Empresa[]
}

model Empresa {
  id              String      @id @default(cuid())
  nome            String
  slug            String      @unique
  planoId         String
  plano           Plano       @relation(fields: [planoId], references: [id])
  status          String      @default("trial") // trial | ativo | inadimplente | cancelado | bloqueado | trial_expirado
  trialExpiraEm   DateTime?
  proximaCobranca DateTime?
  
  // Código de Indicação Único da Empresa (ex: PRINT-123456)
  codigoIndicacao String?     @unique
  indicadoPor     String?     // Código de quem indicou esta empresa

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  profiles               Profile[]
  printers               Printer[]
  filaments              Filament[]
  tintas                 Tinta[]
  pecas                  Peca[]
  pedidos                Pedido[]
  cupons                 Cupom[]
  configuracao           Configuracao?
  filamentPriceHistories FilamentPriceHistory[]

  rewardTransactions     RewardTransaction[]
  rewardRedemptions      RewardRedemption[]
  achievements           AchievementUnlocked[]
  missionProgresses      MissionProgress[]
  digitalAssets          DigitalAsset[]

  @@index([status])
  @@index([planoId])
  @@index([indicadoPor])
}

model Profile {
  id                  String    @id // Supabase auth.users id
  email               String    @unique
  nome                String?
  role                String    @default("admin") // super_admin | admin | funcionario | cliente
  status              String    @default("aprovado") // pendente | aprovado | bloqueado
  aprovadoEm          DateTime?
  empresaId           String?
  empresa             Empresa?  @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  createdAt           DateTime  @default(now())

  pedidos             Pedido[]

  @@index([empresaId])
  @@index([role])
  @@index([status])
}

model Printer {
  id                 String   @id @default(cuid())
  empresaId          String
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome               String
  modelo             String
  preco              Float
  consumoWatts       Float
  vidaUtilHoras      Float
  horasTrabalhadas   Float    @default(0)
  custoManutencaoAno Float    @default(0)
  createdAt          DateTime @default(now())

  @@index([empresaId])
}

model Filament {
  id                 String                 @id @default(cuid())
  empresaId          String
  empresa            Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome               String
  marca              String
  material           String // PLA, ABS, PETG, TPU, Resina, etc.
  cor                String
  precoPorKg         Float
  pesoRestanteGramas Float                  @default(1000.0) // Peso restante em gramas
  createdAt          DateTime               @default(now())
  priceHistory       FilamentPriceHistory[]

  @@index([empresaId])
}

model FilamentPriceHistory {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  filamentId String
  filament   Filament @relation(fields: [filamentId], references: [id], onDelete: Cascade)
  precoPorKg Float
  data       DateTime @default(now())

  @@index([empresaId])
  @@index([filamentId])
}

model Tinta {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  marca     String?
  tipo      String   // Acrílica, Spray, Primer, Verniz, Esmalte, Óleo, Pincel/Insumo
  cor       String?
  volumeMl  Float    @default(0) // Volume da embalagem em ml
  preco     Float    // Preço de compra em R$
  createdAt DateTime @default(now())

  @@index([empresaId])
}

model Peca {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome       String
  descricao  String?
  categoria  String?
  fotoUrl    String?
  publicada  Boolean  @default(false)
  status     String   @default("em_producao") // em_producao | pronta | vendida
  createdAt  DateTime @default(now())

  custoImpressao CustoImpressao?
  custoPintura   CustoPintura?
  custoEmbalagem CustoEmbalagem?
  pedidos        Pedido[]

  @@index([empresaId])
  @@index([status])
  @@index([publicada])
}

model Pedido {
  id             String     @id @default(cuid())
  empresaId      String
  empresa        Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteNome    String
  clienteContato String?    // telefone/whatsapp
  status         String     @default("pendente") // pendente | aguardando_pagamento | em_impressao | pintando | pronto | enviado | entregue | cancelado
  pago           Boolean    @default(false)
  precoAcordado  Float      @default(0)
  quantidade     Int        @default(1)
  cupomCodigo    String?
  pecaId         String
  peca           Peca       @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  usuarioId      String?
  usuario        Profile?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())

  @@index([empresaId])
  @@index([empresaId, status])
  @@index([pecaId])
  @@index([usuarioId])
}

model CustoImpressao {
  id               String @id @default(cuid())
  peca             Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId           String @unique
  printerId        String
  filamentId       String
  pesoGramas       Float
  tempoHoras       Float
  tarifaEnergiaKwh Float
}

model CustoPintura {
  id                 String @id @default(cuid())
  peca               Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId             String @unique
  custoTintas        Float
  tempoHoras         Float
  valorHoraMaoDeObra Float
}

model CustoEmbalagem {
  id                String  @id @default(cuid())
  peca              Peca    @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId            String  @unique
  materialDescricao String?
  custoUnitario     Float
}

model SolicitacaoExclusao {
  id        String   @id @default(cuid())
  usuarioId String
  email     String
  motivo    String?
  status    String   @default("pendente") // pendente | concluido | rejeitado
  createdAt DateTime @default(now())
}

model Configuracao {
  id        String   @id @default(cuid())
  empresaId String   @unique
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  chavePix  String?
  updatedAt DateTime @updatedAt
}

model Cupom {
  id                 String    @id @default(cuid())
  empresaId          String
  empresa            Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo             String
  percentualDesconto Float
  ativo              Boolean   @default(true)
  validoAte          DateTime?
  createdAt          DateTime  @default(now())

  @@unique([empresaId, codigo])
}

// -------------------------------------------------------------
// PRINTFORGE REWARDS — PROGRAMA DE FIDELIDADE E INDICAÇÕES DE NÍVEL ÚNICO
// -------------------------------------------------------------

model RewardLevel {
  id            String   @id @default(cuid())
  nome          String   // Bronze, Prata, Ouro, Diamante, Platinum, Elite
  pontosMinimos Int
  icone         String?
  cor           String?
  beneficios    String?
  ordem         Int      @default(1)
}

model RewardPointsConfig {
  id        String   @id @default(cuid())
  evento    String   @unique // "novo_cadastro", "loja_criada", "primeira_assinatura", "renovacao_mensal", "upgrade_plano", "primeira_venda", "primeiro_produto", "perfil_completo"
  pontos    Int
  ativo     Boolean  @default(true)
  descricao String?
}

model RewardTransaction {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo         String   // "credito" | "debito"
  evento       String   // referencia ao RewardPointsConfig.evento, ou "resgate" para débitos
  pontos       Int
  descricao    String?
  referenciaId String?  // ex: id do resgate, id do evento de indicação
  createdAt    DateTime @default(now())

  @@index([empresaId])
  @@index([empresaId, tipo])
  @@index([referenciaId])
}

model ReferralEvent {
  id                 String   @id @default(cuid())
  indicadorEmpresaId String   // empresa que indicou
  indicadoEmpresaId  String?  // empresa criada a partir da indicação, se já existir
  codigoUsado        String
  status             String   @default("cadastro_iniciado") // cadastro_iniciado | loja_criada | trial | assinatura_paga | cancelado
  createdAt          DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  @@index([indicadorEmpresaId])
  @@index([indicadoEmpresaId])
  @@index([status])
}

model RewardCatalogItem {
  id                String             @id @default(cuid())
  nome              String
  descricao         String?
  imagemUrl         String?
  categoria         String             // filamentos | resinas | pecas | acessorios | cupons | creditos | brindes | premium
  pontosNecessarios Int
  estoque           Int?               // null = ilimitado
  ativo             Boolean            @default(true)
  createdAt         DateTime           @default(now())

  resgates          RewardRedemption[]

  @@index([categoria])
  @@index([ativo])
}

model RewardRedemption {
  id           String            @id @default(cuid())
  empresaId    String
  empresa      Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  itemId       String
  item         RewardCatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  pontosGastos Int
  status       String            @default("solicitado") // solicitado | em_processamento | enviado | entregue | cancelado
  createdAt    DateTime          @default(now())

  @@index([empresaId])
  @@index([itemId])
  @@index([status])
}

model Achievement {
  id            String                @id @default(cuid())
  nome          String
  descricao     String
  icone         String?
  raridade      String                // comum | raro | epico | lendario
  criterioTipo  String                // ex: "indicacoes_total", "pontos_total", "resgates_total"
  criterioValor Int

  unlockedBy    AchievementUnlocked[]
}

model AchievementUnlocked {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  desbloqueadoEm DateTime   @default(now())

  @@unique([empresaId, achievementId])
  @@index([empresaId])
}

model Mission {
  id               String            @id @default(cuid())
  nome             String
  descricao        String
  tipo             String            // diaria | semanal | mensal
  criterioTipo     String
  criterioValor    Int
  recompensaPontos Int
  ativo            Boolean           @default(true)

  progresses       MissionProgress[]
}

model MissionProgress {
  id                String    @id @default(cuid())
  empresaId         String
  empresa           Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  missionId         String
  mission           Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progresso         Int       @default(0)
  concluida         Boolean   @default(false)
  periodoReferencia String    // ex: "2026-07" ou "2026-W30"
  concluidaEm       DateTime?

  @@unique([empresaId, missionId, periodoReferencia])
  @@index([empresaId])
}

model DigitalAsset {
  id             String         @id @default(cuid())
  empresaId      String
  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome           String
  descricao      String?
  tipo           String         // STL | THREE_MF | GCODE | OBJ
  hashSha256     String         // Fingerprint unívoco
  versaoAtualId  String?
  thumbnailUrl   String?
  status         String         @default("ativo") // ativo | arquivado
  tags           String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  versoes        AssetVersion[]

  @@index([empresaId])
  @@index([hashSha256])
  @@index([tipo])
}

model AssetVersion {
  id                String              @id @default(cuid())
  assetId           String
  asset             DigitalAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  numeroVersao      Int                 @default(1) // v1, v2, v3
  storageUrl        String
  hashSha256        String
  changelog         String?
  autorProfileId    String?
  volumeCm3         Float               @default(0)
  pesoGramas        Float               @default(0)
  larguraMm         Float               @default(0)
  profundidadeMm    Float               @default(0)
  alturaMm          Float               @default(0)
  poligonosCount    Int                 @default(0)
  metadadosFatiador String?             // JSON string (slicer, temperaturas, altura camada, etc)
  createdAt         DateTime            @default(now())

  inspecoesAi       AssetAiInspection[]

  @@index([assetId])
  @@index([hashSha256])
}

model AssetAiInspection {
  id                      String       @id @default(cuid())
  versionId               String
  version                 AssetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  scoreWarping            Int          @default(0) // 0-100
  classificacaoWarping    String       @default("baixo")
  temParedesFinas         Boolean      @default(false)
  necessitaSuporte        Boolean      @default(false)
  temperaturaBicoSugerida  Int          @default(210)
  temperaturaMesaSugerida Int          @default(60)
  alertasTecnicos         String[]     @default([])
  recomendacoesIA         String[]     @default([])
  createdAt               DateTime     @default(now())

  @@index([versionId])
}

