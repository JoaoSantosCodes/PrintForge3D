// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plano {
  id               String    @id @default(cuid())
  nome             String    // ex: "Starter", "Pro", "Business"
  slug             String    @unique
  precoMensal      Float
  limiteImpressoras Int
  limitePecas      Int
  limitePedidosMes Int
  limiteUsuarios   Int       @default(5)
  ativo            Boolean   @default(true)
  createdAt        DateTime  @default(now())

  empresas         Empresa[]
}

model Empresa {
  id              String      @id @default(cuid())
  nome            String
  slug            String      @unique
  planoId         String
  plano           Plano       @relation(fields: [planoId], references: [id])
  status          String      @default("trial") // trial | ativo | inadimplente | cancelado | bloqueado | trial_expirado
  trialExpiraEm   DateTime?
  proximaCobranca DateTime?
  
  // Código de Indicação Único da Empresa (ex: PRINT-123456)
  codigoIndicacao String?     @unique
  indicadoPor     String?     // Código de quem indicou esta empresa

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  profiles               Profile[]
  printers               Printer[]
  filaments              Filament[]
  tintas                 Tinta[]
  pecas                  Peca[]
  pedidos                Pedido[]
  cupons                 Cupom[]
  configuracao           Configuracao?
  companySettings        CompanySettings?
  filamentPriceHistories FilamentPriceHistory[]

  rewardTransactions     RewardTransaction[]
  rewardRedemptions      RewardRedemption[]
  achievements           AchievementUnlocked[]
  missionProgresses      MissionProgress[]
  digitalAssets          DigitalAsset[]
  printerTelemetries     PrinterTelemetry[]
  timelineEvents         TimelineEvent[]
  auditLogs              AuditLog[]
  aiConversations        AiConversation[]
  aiMemories             AiMemory[]
  referralEvents         ReferralEvent[]

  @@index([status])
  @@index([planoId])
  @@index([indicadoPor])
  @@index([id, status])
}

model CompanySettings {
  id          String   @id @default(cuid())
  empresaId   String   @unique
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  payloadJson String   @default("{}") // Configurações em JSONB (markup, moeda, impostos MEI, telegram)
  updatedAt   DateTime @updatedAt
}

model Profile {
  id                  String    @id // Supabase auth.users id
  email               String    @unique
  nome                String?
  role                String    @default("admin") // super_admin | admin | funcionario | cliente
  status              String    @default("aprovado") // pendente | aprovado | bloqueado
  aprovadoEm          DateTime?
  empresaId           String?
  empresa             Empresa?  @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  createdAt           DateTime  @default(now())

  pedidos             Pedido[]
  solicitacoesExclusao SolicitacaoExclusao[]

  @@index([empresaId])
  @@index([role])
  @@index([status])
}

model SolicitacaoExclusao {
  id        String   @id @default(cuid())
  profileId String?
  usuarioId String?
  email     String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  status    String   @default("pendente")
  motivo    String?
  createdAt DateTime @default(now())

  @@index([profileId])
}

model Printer {
  id                 String   @id @default(cuid())
  empresaId          String
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome               String
  modelo             String
  preco              Float
  consumoWatts       Float
  vidaUtilHoras      Float
  horasTrabalhadas   Float    @default(0)
  custoManutencaoAno Float    @default(0)
  createdAt          DateTime @default(now())

  profiles           PrinterProfile[]
  telemetries        PrinterTelemetry[]
  maintenances       PrinterMaintenance[]

  @@index([empresaId])
  @@index([empresaId, id])
}

model PrinterProfile {
  id                 String   @id @default(cuid())
  printerId          String
  printer            Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  tipoBicoMm         Float    @default(0.4)
  temperaturaMaxBico Int      @default(300)
  temperaturaMaxMesa Int      @default(110)
  velocidadeMaxMmS   Int      @default(250)
  aceleracaoMmS2     Int      @default(5000)
  firmware           String?  @default("Marlin / Klipper / BambuOS")

  @@index([printerId])
}

model PrinterTelemetry {
  id              String   @id @default(cuid())
  empresaId       String
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  printerId       String
  printer         Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  timestamp       DateTime @default(now())
  temperaturaBico Float    @default(0)
  temperaturaMesa Float    @default(0)
  velocidadeMmS   Float    @default(0)
  fanSpeedPercent Int      @default(0)
  jobAtualId      String?
  status          String   @default("idle") // idle | printing | paused | error

  @@index([empresaId])
  @@index([printerId, timestamp])
}

model PrinterMaintenance {
  id             String   @id @default(cuid())
  printerId      String
  printer        Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  descricao      String
  custoBRL       Float    @default(0)
  tipo           String   @default("preventiva") // preventiva | corretiva
  dataManutencao DateTime @default(now())

  @@index([printerId])
}

model Filament {
  id                 String                 @id @default(cuid())
  empresaId          String
  empresa            Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome               String
  marca              String
  material           String // PLA, ABS, PETG, TPU, Resina, etc.
  cor                String
  precoPorKg         Float
  pesoRestanteGramas Float                  @default(1000.0) // Peso restante em gramas
  createdAt          DateTime               @default(now())
  priceHistory       FilamentPriceHistory[]

  @@index([empresaId])
}

model FilamentPriceHistory {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  filamentId String
  filament   Filament @relation(fields: [filamentId], references: [id], onDelete: Cascade)
  precoPorKg Float
  data       DateTime @default(now())

  @@index([empresaId])
  @@index([filamentId])
}

model Tinta {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  marca     String?
  tipo      String   // Acrílica, Spray, Primer, Verniz, Esmalte, Óleo, Pincel/Insumo
  cor       String?
  volumeMl  Float    @default(0) // Volume da embalagem em ml
  preco     Float    // Preço de compra em R$
  createdAt DateTime @default(now())

  @@index([empresaId])
}

model Peca {
  id         String   @id @default(cuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome       String
  descricao  String?
  categoria  String?
  fotoUrl    String?
  publicada  Boolean  @default(false)
  status     String   @default("em_producao") // em_producao | pronta | vendida
  createdAt  DateTime @default(now())

  custoImpressao CustoImpressao?
  custoPintura   CustoPintura?
  custoEmbalagem CustoEmbalagem?
  metricas       PecaMetrics?
  precificacao   PecaPricing?
  pedidos        Pedido[]

  @@index([empresaId])
  @@index([status])
  @@index([publicada])
  @@index([empresaId, status])
}

model PecaMetrics {
  id                   String @id @default(cuid())
  pecaId               String @unique
  peca                 Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  totalImpressoes      Int    @default(0)
  taxaSucessoPercentual Float @default(100.0)
  tempoTotalHoras      Float  @default(0)
  massaTotalGrams      Float  @default(0)
}

model PecaPricing {
  id                       String @id @default(cuid())
  pecaId                   String @unique
  peca                     Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  margemDesejadaPercentual Float  @default(50.0)
  precoSugeridoBRL         Float  @default(0)
  precoCobradoBRL          Float  @default(0)
}

model Pedido {
  id             String     @id @default(cuid())
  empresaId      String
  empresa        Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteNome    String
  clienteContato String?    // telefone/whatsapp
  status         String     @default("pendente") // pendente | aguardando_pagamento | em_impressao | pintando | pronto | enviado | entregue | cancelado
  pago           Boolean    @default(false)
  precoAcordado  Float      @default(0)
  quantidade     Int        @default(1)
  cupomCodigo    String?
  pecaId         String
  peca           Peca       @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  usuarioId      String?
  usuario        Profile?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())

  @@index([empresaId])
  @@index([empresaId, status])
  @@index([pecaId])
  @@index([usuarioId])
}

model CustoImpressao {
  id               String @id @default(cuid())
  peca             Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId           String @unique
  printerId        String
  filamentId       String
  pesoGramas       Float
  tempoHoras       Float
  tarifaEnergiaKwh Float
}

model CustoPintura {
  id                 String @id @default(cuid())
  peca               Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId             String @unique
  custoTintas        Float
  tempoHoras         Float
  valorHoraMaoDeObra Float
}

model CustoEmbalagem {
  id                String  @id @default(cuid())
  peca              Peca    @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  pecaId            String  @unique
  materialDescricao String?
  custoUnitario     Float
}

model Cupom {
  id                 String    @id @default(cuid())
  empresaId          String
  empresa            Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo             String
  desconto           Float     @default(0) // Valor ou porcentagem
  percentualDesconto Float     @default(0) // Alias compatibilidade
  tipo               String    @default("porcentagem") // "porcentagem" | "fixo"
  ativo              Boolean   @default(true)
  validade           DateTime?
  validoAte          DateTime? // Alias compatibilidade
  usosAtuais         Int       @default(0)
  limiteUsos         Int?
  createdAt          DateTime  @default(now())

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model Configuracao {
  id               String   @id @default(cuid())
  empresaId        String   @unique
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tarifaEnergiaKwh Float    @default(0.85)
  margemPadrao     Float    @default(100.0)
  chavePix         String?
  updatedAt        DateTime @updatedAt
}

// -------------------------------------------------------------
// DOMÍNIO: DIGITAL ASSET MANAGEMENT (DAM) & ATIVOS 3D
// -------------------------------------------------------------

model DigitalAsset {
  id             String           @id @default(cuid())
  empresaId      String
  empresa        Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome           String
  descricao      String?
  tipo           String           // STL | THREE_MF | GCODE | OBJ
  hashSha256     String           // Fingerprint unívoco
  versaoAtualId  String?
  thumbnailUrl   String?
  status         String           @default("ativo") // ativo | arquivado
  tags           String[]         @default([])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  versoes        AssetVersion[]
  thumbnails     AssetThumbnail[]

  @@index([empresaId])
  @@index([hashSha256])
  @@index([tipo])
}

model AssetVersion {
  id                String              @id @default(cuid())
  assetId           String
  asset             DigitalAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  numeroVersao      Int                 @default(1) // v1, v2, v3
  storageUrl        String
  hashSha256        String
  changelog         String?
  autorProfileId    String?
  volumeCm3         Float               @default(0)
  pesoGramas        Float               @default(0)
  larguraMm         Float               @default(0)
  profundidadeMm    Float               @default(0)
  alturaMm          Float               @default(0)
  poligonosCount    Int                 @default(0)
  metadadosFatiador String?             // JSON string (slicer, temperaturas, altura camada, etc)
  createdAt         DateTime            @default(now())

  inspecoesAi       AssetAiInspection[]
  metadados         AssetMetadata[]

  @@index([assetId])
  @@index([hashSha256])
}

model AssetThumbnail {
  id           String       @id @default(cuid())
  assetId      String
  asset        DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  thumbnailUrl String
  larguraPx    Int          @default(400)
  alturaPx     Int          @default(400)

  @@index([assetId])
}

model AssetMetadata {
  id              String       @id @default(cuid())
  versionId       String
  version         AssetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  slicerDetectado String?
  softwareVersao  String?
  perfilJson      String?

  @@index([versionId])
}

model AssetAiInspection {
  id                      String       @id @default(cuid())
  versionId               String
  version                 AssetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  scoreWarping            Int          @default(0) // 0-100
  classificacaoWarping    String       @default("baixo")
  temParedesFinas         Boolean      @default(false)
  necessitaSuporte        Boolean      @default(false)
  temperaturaBicoSugerida  Int          @default(210)
  temperaturaMesaSugerida Int          @default(60)
  alertasTecnicos         String[]     @default([])
  recomendacoesIA         String[]     @default([])
  createdAt               DateTime     @default(now())

  @@index([versionId])
}

// -------------------------------------------------------------
// DOMÍNIO: REWARDS, GAMIFICATION & INDICAÇÕES
// -------------------------------------------------------------

model RewardTransaction {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo         String   // "ganho" | "resgate" | "expiracao" | "bonus"
  evento       String?  // Alias compatibilidade
  pontos       Int
  descricao    String
  referencia   String?  // ID do pedido ou indicação geradora
  referenciaId String?  // Alias compatibilidade
  createdAt    DateTime @default(now())

  @@index([empresaId])
}

model ReferralEvent {
  id                 String   @id @default(cuid())
  empresaId          String
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  indicadorEmpresaId String?
  indicadoEmpresaId  String?  // Alias compatibilidade
  codigoUsado        String?
  tipo               String
  status             String   @default("aprovado") // aprovado | pendente
  pontos             Int      @default(0)
  descricao          String?
  createdAt          DateTime @default(now())

  @@index([empresaId])
}

model RewardPointsConfig {
  id        String  @id @default(cuid())
  evento    String  @unique
  pontos    Int     @default(10)
  descricao String?
  ativo     Boolean @default(true)
}

model RewardLevel {
  id            String  @id @default(cuid())
  nome          String
  nivel         Int     @default(1) // Level 1, 2, 3
  ordem         Int     @default(1)
  minPontos     Int     @default(0)
  pontosMinimos Int     @default(0) // Alias compatibilidade
  multiplicador Float   @default(1.0)
  icone         String?
  cor           String?
  beneficios    String?
}

model RewardCatalogItem {
  id                String             @id @default(cuid())
  nome              String
  descricao         String?
  imagemUrl         String?
  categoria         String             // filamentos | resinas | pecas | acessorios | cupons | creditos | brindes | premium
  pontosNecessarios Int
  estoque           Int?               // null = ilimitado
  ativo             Boolean            @default(true)
  createdAt         DateTime           @default(now())

  resgates          RewardRedemption[]

  @@index([categoria])
  @@index([ativo])
}

model RewardRedemption {
  id           String            @id @default(cuid())
  empresaId    String
  empresa      Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  itemId       String
  item         RewardCatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  pontosGastos Int
  status       String            @default("solicitado") // solicitado | em_processamento | enviado | entregue | cancelado
  createdAt    DateTime          @default(now())

  @@index([empresaId])
  @@index([itemId])
  @@index([status])
}

model Achievement {
  id            String                @id @default(cuid())
  nome          String
  descricao     String
  icone         String?
  raridade      String                // comum | raro | epico | lendario
  criterioTipo  String                // ex: "indicacoes_total", "pontos_total", "resgates_total"
  criterioValor Int

  unlockedBy    AchievementUnlocked[]
}

model AchievementUnlocked {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  desbloqueadoEm DateTime   @default(now())

  @@unique([empresaId, achievementId])
  @@index([empresaId])
}

model Mission {
  id               String            @id @default(cuid())
  nome             String
  descricao        String
  tipo             String            // diaria | semanal | mensal
  criterioTipo     String
  criterioValor    Int
  recompensaPontos Int
  ativo            Boolean           @default(true)

  progresses       MissionProgress[]
}

model MissionProgress {
  id                String    @id @default(cuid())
  empresaId         String
  empresa           Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  missionId         String
  mission           Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progresso         Int       @default(0)
  concluida         Boolean   @default(false)
  periodoReferencia String    // ex: "2026-07" ou "2026-W30"
  concluidaEm       DateTime?

  @@unique([empresaId, missionId, periodoReferencia])
  @@index([empresaId])
}

// -------------------------------------------------------------
// DOMÍNIO: INTELIGÊNCIA ARTIFICIAL & COPILOT MEMORY ENGINE
// -------------------------------------------------------------

model AiConversation {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  titulo    String
  usuarioId String?
  createdAt DateTime @default(now())

  @@index([empresaId])
}

model AiMemory {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  chave     String
  valorJson String   @default("{}")
  updatedAt DateTime @updatedAt

  @@unique([empresaId, chave])
  @@index([empresaId])
}

// -------------------------------------------------------------
// DOMÍNIO: UNIVERSAL TIMELINE & AUDIT LOGS
// -------------------------------------------------------------

model TimelineEvent {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  entityType  String   // PECA | PEDIDO | JOB | IMPRESSORA | ATIVO_3D
  entityId    String
  event       String   // ex: "CRIADO", "FATIAMENTO_CONCLUIDO", "IMPRESSAO_INICIADA", "ENTREGUE"
  payloadJson String   @default("{}") // JSONB estendido com snapshot do evento
  createdAt   DateTime @default(now())

  @@index([empresaId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId   String?
  acao        String
  recurso     String
  ip          String?
  payloadJson String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([empresaId])
  @@index([createdAt])
}

model SecurityLog {
  id           String   @id @default(cuid())
  empresaId    String?
  tipoEvento   String   // LOGIN_FALHO | TENTATIVA_INVASAO | ACCESS_DENIED
  severidade   String   @default("info") // info | warning | critical
  detalhesJson String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([tipoEvento])
  @@index([createdAt])
}

model SystemLog {
  id           String   @id @default(cuid())
  modulo       String
  nivel        String   @default("info") // info | warn | error
  mensagem     String
  contextoJson String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([modulo])
  @@index([nivel])
  @@index([createdAt])
}
