{
  "name": "printforge-3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:tenant": "vitest run src/lib/__tests__/isolamento-multiempresa.test.ts",
    "seed": "npx tsx prisma/seed.ts",
    "seed:admin": "npx tsx prisma/seed-admin.ts",
    "seed:superadmin": "npx tsx prisma/seed-superadmin.ts",
    "seed:multi-tenant": "npx tsx prisma/seed-multi-tenant.ts",
    "db:reset": "prisma db push --force-reset && npx tsx prisma/seed.ts && npx tsx prisma/seed-admin.ts && npx tsx prisma/seed-superadmin.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/three": "^0.185.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.441.0",
    "next": "14.2.11",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.2",
    "three": "^0.185.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
