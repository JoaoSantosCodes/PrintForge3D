# ==========================================
# PRINTFORGE 3D — VARIÁVEIS DE AMBIENTE (.env.example)
# ==========================================

# 1. BANCO DE DADOS (PRISMA)
# Em desenvolvimento local: "file:./dev.db"
# Em produção (Supabase PostgreSQL / Neon):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. SUPABASE AUTH & STORAGE
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. CONTA DE ADMINISTRADOR INICIAL (SEED)
# Utilizado pelo script "npm run seed:admin" para criar/promover o primeiro administrador do sistema
ADMIN_EMAIL="admin@printforge3d.com"
ADMIN_PASSWORD="SuaSenhaSegura123!"

# 4. ENVIO DE E-MAILS DE NOTIFICAÇÃO (OPCIONAL - RESEND)
# Se não configurado, o sistema apenas loga os e-mails no console sem falhar a aplicação
RESEND_API_KEY="re_123456789..."
EMAIL_FROM="PrintForge 3D <notificacoes@printforge3d.com>"
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com"
